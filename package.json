{
  "private": true,
  "scripts": {
    "dev": "NUXT_DEV_SERVER=true nuxi dev --host 0.0.0.0",
    "dev:local": "node scripts/start-preview.mjs",
    "build": "nuxi build",
    "preview": "pnpm dev:local",
    "db:generate": "drizzle-kit generate",
    "db:migrations:list:remote": "wrangler d1 migrations list DB --remote",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:deploy": "pnpm db:generate && pnpm db:migrate:remote",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@iconify-json/lucide": "^1.2.49",
    "@iconify-json/simple-icons": "^1.2.38",
    "@libsql/client": "^0.17.4",
    "@nuxt/ui": "^3.1.3",
    "@nuxthub/core": "^0.10.8",
    "@pinia/colada": "^0.17.1",
    "@pinia/colada-nuxt": "^0.2.1",
    "@pinia/nuxt": "^0.11.1",
    "@vite-pwa/nuxt": "1.1.1",
    "drizzle-orm": "0.44.2",
    "h3-zod": "^0.5.3",
    "heic-to": "^1.5.2",
    "nuxt": "^4.2.1",
    "nuxt-auth-utils": "^0.5.20",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "4.7.1",
    "postgres": "^3.4.7",
    "stripe": "^22.3.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@nuxt/devtools": "^2.5.0",
    "@nuxt/eslint": "^1.4.1",
    "@nuxt/icon": "^1.15.0",
    "@types/node": "^25.0.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.29.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.20.1"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping": "2.10.43",
      "browserslist": "4.28.6",
      "caniuse-lite": "1.0.30001805"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "vue-demi",
      "workerd"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}
